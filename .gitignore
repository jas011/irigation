# Standard gitignore rules for Python + Node monorepos

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.example
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Python / backend
backend/.venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/*/__pycache__/
backend/.env
backend/.env.example
backend/*.pyc
backend/*.log

# Database data
postgres_data/

# OS/Editor configs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
